# =============================================================================
# Ingenio Cloud — VPS Production
# Copiar a /opt/ingenio-cloud/.env en VPS Hostinger srv878399, completar valores
# NUNCA commitear .env real al repo
# =============================================================================

# ─── Dominio ─────────────────────────────────────────────────────────────────
DOMAIN_NAME=ingcloud.srv878399.hstgr.cloud

# ─── Supabase self-hosted (red supabase_network) ─────────────────────────────
SUPABASE_URL=http://kong:8000
NEXT_PUBLIC_SUPABASE_URL=https://ingenio-supabase.srv878399.hstgr.cloud
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

DB_HOST=supabase-db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=postgres

DATABASE_URL=postgresql://postgres.default:PASSWORD@srv878399.hstgr.cloud:6545/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@srv878399.hstgr.cloud:5432/postgres

# ─── JWT app interna ─────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Webhooks ────────────────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=
MILL_SPEED_WEBHOOK_SECRET=

# ─── MSSQL CORONA legacy (read-only) ─────────────────────────────────────────
MSSQL_HOST=192.168.0.177
MSSQL_PORT=1433
MSSQL_DATABASE=CORONA
MSSQL_USER=fs1
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ─── HTTP externo molienda ───────────────────────────────────────────────────
MOLIENDA_HTTP_URL=
MOLIENDA_HTTP_AUTH=

# ─── InfluxDB 3 (histórico raw) ──────────────────────────────────────────────
INFLUX_URL=http://influxdb3:8181
INFLUX_TOKEN=
INFLUX_DATABASE=corona2026

# ─── IA APIs ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─── Comms (stack existente) ─────────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
RESEND_API_KEY=
MAIL_FROM=alertas@ingcloud.srv878399.hstgr.cloud

# ─── Observabilidad (Sprint 1+) ──────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://langfuse.ingcloud.srv878399.hstgr.cloud

# ─── App defaults ────────────────────────────────────────────────────────────
NODE_ENV=production
TZ=America/Argentina/Buenos_Aires
PORT=3001
FRONTEND_URL=https://ingcloud.srv878399.hstgr.cloud
BACKEND_URL=https://api.ingcloud.srv878399.hstgr.cloud/api
NEXT_PUBLIC_API_URL=https://api.ingcloud.srv878399.hstgr.cloud/api
NEXT_PUBLIC_APP_NAME=Ingenio Cloud
NEXT_PUBLIC_APP_URL=https://ingcloud.srv878399.hstgr.cloud
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=lacorona
NEXT_PUBLIC_DEFAULT_PLANT_SLUG=planta-sur

# Feature flags
NEXT_PUBLIC_COPILOT_ENABLED=false
NEXT_PUBLIC_TV_AUTO_FULLSCREEN=true
AGENT_API_KEY=
