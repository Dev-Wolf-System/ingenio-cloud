# =============================================================================
# Ingenio Cloud — Desarrollo local (gitignored)
# Copiar a backend/.env.local y frontend/.env.local respectivamente
# =============================================================================

NODE_ENV=development
TZ=America/Argentina/Buenos_Aires
PORT=3001

# Supabase production (compartido — solo lectura para dev)
SUPABASE_URL=https://ingenio-supabase.srv878399.hstgr.cloud
NEXT_PUBLIC_SUPABASE_URL=https://ingenio-supabase.srv878399.hstgr.cloud
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.default:PASS@srv878399.hstgr.cloud:6545/postgres

# JWT dev
JWT_SECRET=dev-secret-rotar-en-prod
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# URLs locales
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Webhooks dev
N8N_WEBHOOK_SECRET=dev-n8n-secret
MILL_SPEED_WEBHOOK_SECRET=dev-mill-secret

# MSSQL CORONA (via Tailscale)
MSSQL_HOST=192.168.0.177
MSSQL_PORT=1433
MSSQL_DATABASE=CORONA
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# HTTP molienda (mock dev)
MOLIENDA_HTTP_URL=http://localhost:3001/api/__mock/molienda

# IA dev (vacío)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Comms (vacío en dev)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Defaults
NEXT_PUBLIC_APP_NAME=Ingenio Cloud (DEV)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=lacorona
NEXT_PUBLIC_DEFAULT_PLANT_SLUG=planta-sur
NEXT_PUBLIC_COPILOT_ENABLED=false
NEXT_PUBLIC_TV_AUTO_FULLSCREEN=true
