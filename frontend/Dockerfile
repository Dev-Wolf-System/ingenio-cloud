# ---- Stage 1: Builder ----
FROM node:20-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_APP_NAME=Ingenio\ Cloud
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_DEFAULT_TENANT_SLUG=lacorona
ARG NEXT_PUBLIC_DEFAULT_PLANT_SLUG=planta-sur
ARG NEXT_PUBLIC_COPILOT_ENABLED=false
ARG NEXT_PUBLIC_TV_AUTO_FULLSCREEN=true

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_DEFAULT_TENANT_SLUG=$NEXT_PUBLIC_DEFAULT_TENANT_SLUG
ENV NEXT_PUBLIC_DEFAULT_PLANT_SLUG=$NEXT_PUBLIC_DEFAULT_PLANT_SLUG
ENV NEXT_PUBLIC_COPILOT_ENABLED=$NEXT_PUBLIC_COPILOT_ENABLED
ENV NEXT_PUBLIC_TV_AUTO_FULLSCREEN=$NEXT_PUBLIC_TV_AUTO_FULLSCREEN

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# ---- Stage 2: Runtime ----
FROM node:20-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV TZ=America/Argentina/Buenos_Aires
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN apk add --no-cache tzdata curl

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:3000 -I || exit 1

USER node
CMD ["node", "server.js"]
